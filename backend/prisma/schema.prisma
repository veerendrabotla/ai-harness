  @@unique([workspaceId, userId, endpoint, windowStart])
  @@index([workspaceId, endpoint, windowStart])
  @@index([userId, endpoint, windowStart])
  @@map("rate_limits")
}

// ── File Versioning ────────────────────────────────────────

model FileVersion {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  path        String   @db.VarChar(1024)
  version     Int
  size        Int      @default(0)
  mimeType    String?  @map("mime_type") @db.VarChar(255)
  contentHash String   @map("content_hash") @db.VarChar(64)
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader    User?    @relation("FileVersionUploader", fields: [uploadedBy], references: [id])

  @@unique([projectId, path, version])
  @@index([projectId, path])
  @@index([projectId])
  @@map("file_versions")
}

// ── Email Delivery Tracking ────────────────────────────────

model EmailDelivery {
  id             String      @id @default(uuid()) @db.Uuid
  recipientEmail String      @map("recipient_email") @db.VarChar(320)
  templateType   String      @map("template_type") @db.VarChar(100)
  subject        String      @db.VarChar(500)
  status         EmailStatus @default(QUEUED)
  workspaceId    String?     @map("workspace_id") @db.Uuid
  metadata       Json?
  externalId     String?     @map("external_id") @db.VarChar(255)
  errorMessage   String?     @map("error_message")
  queuedAt       DateTime    @default(now()) @map("queued_at") @db.Timestamptz(6)
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime?   @map("delivered_at") @db.Timestamptz(6)
  openedAt       DateTime?   @map("opened_at") @db.Timestamptz(6)
  bouncedAt      DateTime?   @map("bounced_at") @db.Timestamptz(6)
  complaintAt    DateTime?   @map("complaint_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace      Workspace?  @relation(fields: [workspaceId], references: [id])

  @@index([recipientEmail])
  @@index([workspaceId])
  @@index([status])
  @@index([templateType])
  @@index([createdAt])
  @@map("email_deliveries")
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  COMPLAINT
}

// ── Email Unsubscribe ──────────────────────────────────────

model EmailUnsubscribe {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @db.VarChar(320)
  unsubscribeType String   @map("unsubscribe_type") @db.VarChar(100)
  workspaceId     String?  @map("workspace_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([email, unsubscribeType])
  @@index([email])
  @@index([workspaceId])
  @@map("email_unsubscribes")
}

// ── Billing ──────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
  PAUSED
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @unique @map("workspace_id") @db.Uuid
  stripeCustomerId     String?            @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  stripeSessionId      String?            @unique @map("stripe_session_id") @db.VarChar(255)
  plan                 String             @default("free") @db.VarChar(50)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  trialStart           DateTime?          @map("trial_start") @db.Timestamptz(6)
  trialEnd             DateTime?          @map("trial_end") @db.Timestamptz(6)
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model WorkspaceBackup {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  sizeBytes          Int              @default(0) @map("size_bytes")
  data               Json
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("workspace_backups")
}

model OrganizationSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationDomain {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  domain           String           @db.VarChar(255)
  status           String           @default("PENDING") @db.VarChar(50)
  verificationToken String          @map("verification_token") @db.VarChar(255)
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@map("organization_domains")
}

model AuditRetentionSetting {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @unique @map("workspace_id") @db.Uuid
  settings    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("audit_retention_settings")
}

// ── Knowledge Base ──────────────────────────────────────────

enum KnowledgeEntryType {
  DOCUMENT
  CODE_SNIPPET
  LINK
  NOTE
}

model KnowledgeEntry {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  title       String              @db.VarChar(500)
  content     String              @db.Text
  type        KnowledgeEntryType  @default(NOTE)
  tags        Json                @default("[]")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
  @@map("knowledge_entries")
}

// ── WebContainer Sessions ────────────────────────────────────

model WebContainerSession {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  status      String   @default("CREATING") @db.VarChar(50)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([expiresAt])
  @@map("webcontainer_sessions")
}

model WebContainerSetting {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("webcontainer_settings")
}

// ── Provider Health History ──────────────────────────────────

model ProviderHealthCheck {
  id                 String   @id @default(uuid()) @db.Uuid
  providerConnectionId String @map("provider_connection_id") @db.Uuid
  ok                 Boolean
  latencyMs          Int      @map("latency_ms")
  checkedAt          DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([providerConnectionId, checkedAt])
  @@map("provider_health_checks")
}

// ── Scheduled tasks (recurring/one-shot cron-lite, UTC presets) ────────────

enum ScheduleCadence {
  EVERY_MINUTES
  HOURLY
  DAILY
  WEEKLY
}

model TaskSchedule {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  createdBy       String          @map("created_by") @db.Uuid
  name            String          @db.VarChar(160)
  goal            String
  constraints     String?
  cadence         ScheduleCadence
  intervalMinutes Int?            @map("interval_minutes")
  minuteOfHour    Int?            @map("minute_of_hour")
  timeOfDay       String?         @map("time_of_day") @db.VarChar(5)
  dayOfWeek       Int?            @map("day_of_week")
  enabled         Boolean         @default(true)
  nextRunAt       DateTime        @map("next_run_at") @db.Timestamptz(6)
  lastRunAt       DateTime?       @map("last_run_at") @db.Timestamptz(6)
  lastTaskId      String?         @map("last_task_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User      @relation("TaskScheduleCreator", fields: [createdBy], references: [id])
  lastTask  Task?     @relation("TaskScheduleLastTask", fields: [lastTaskId], references: [id])

  @@index([enabled, nextRunAt])
  @@index([workspaceId])
  @@map("task_schedules")
}
