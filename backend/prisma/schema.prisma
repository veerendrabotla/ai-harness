generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                      String                        @id @default(uuid()) @db.Uuid
  email                   String                        @unique @db.VarChar(320)
  passwordHash            String                        @map("password_hash")
  displayName             String                        @map("display_name") @db.VarChar(100)
  avatarUrl               String?                       @map("avatar_url")
  status                  UserStatus                    @default(ACTIVE)
  platformRole            PlatformRole                  @default(USER) @map("platform_role")
  twoFactorEnabled        Boolean                       @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?                       @map("two_factor_secret")
  notificationPreferences Json?                         @default("{\"email\":true}") @map("notification_preferences")
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvalDecisions       ApprovalRequest[]             @relation("ApprovalDecider")
  auditLogs               AuditLog[]
  auditLogEntries         AuditLogEntry[]
  bridges                 Bridge[]
  checkpoints             Checkpoint[]                  @relation("CheckpointCreator")
  mcpServers              McpServer[]
  organizationMemberships OrganizationMember[]
  ownedOrganizations      Organization[]                @relation("OrganizationOwner")
  passwordResetTokens     PasswordResetToken[]
  providerConnections     ProviderConnection[]
  refreshSessions         RefreshSession[]
  sessionExports          SessionExport[]
  sessionShares           SessionShare[]
  createdDeployments      Deployment[]
  approvedPlans           TaskPlan[]                    @relation("PlanApprover")
  createdTasks            Task[]                        @relation("TaskCreator")
  createdSchedules        TaskSchedule[]                @relation("TaskScheduleCreator")
  instructionVersions     WorkspaceInstructionVersion[] @relation("InstructionAuthor")
  sentInvites             WorkspaceInvite[]
  workspaceMemberships    WorkspaceMember[]
  ownedWorkspaces         Workspace[]                   @relation("WorkspaceOwner")
  deploymentComments      DeploymentComment[]
  projectPermissions      ProjectTeamPermission[]
  notifications           Notification[]
  fileVersions            FileVersion[]                 @relation("FileVersionUploader")

  @@index([status])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Workspace {
  id                   String                        @id @default(uuid()) @db.Uuid
  ownerId              String                        @map("owner_id") @db.Uuid
  organizationId       String?                       @map("organization_id") @db.Uuid
  name                 String                        @db.VarChar(120)
  description          String?
  executionMode        ExecutionMode                 @default(CLOUD) @map("execution_mode")
  status               WorkspaceStatus               @default(ACTIVE)
  ipAllowlist          String[]                      @map("ip_allowlist")
  ipAllowlistEnabled   Boolean                       @default(false) @map("ip_allowlist_enabled")
  webhookUrls          String[]                      @map("webhook_urls")
  apiKeys              ApiKey[]
  featureFlags         FeatureFlag[]
  taskTemplates        TaskTemplate[]
  costAlerts           CostAlert[]
  ssoConfigs           SsoConfig[]
  rateLimits           RateLimit[]
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs            AuditLog[]
  auditLogEntries      AuditLogEntry[]
  modelRoutes          ModelRoute[]
  projects             Project[]
  sessions             Session[]
  tasks                Task[]
  taskSchedules        TaskSchedule[]
  instructionVersions  WorkspaceInstructionVersion[]
  invites              WorkspaceInvite[]
  mcpLinks             WorkspaceMcpServer[]
  members              WorkspaceMember[]
  policy               WorkspacePolicy?
  providerLinks        WorkspaceProviderConnection[]
  webhookSubscriptions WebhookSubscription[]
  emailDeliveries      EmailDelivery[]
  subscription         Subscription?
   backups              WorkspaceBackup[]
   auditRetention       AuditRetentionSetting?
   knowledgeEntries     KnowledgeEntry[]
   webcontainerSessions WebContainerSession[]
   webcontainerSetting  WebContainerSetting?
   organization         Organization?                 @relation(fields: [organizationId], references: [id])
  owner                User                          @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([organizationId])
  @@index([status])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id                   String                  @id @default(uuid()) @db.Uuid
  workspaceId          String                  @map("workspace_id") @db.Uuid
  bridgeId             String?                 @map("bridge_id") @db.Uuid
  name                 String                  @db.VarChar(160)
  connectionType       ProjectConnectionType   @default(CLOUD) @map("connection_type")
  repositoryUrl        String?                 @map("repository_url")
  rootReference        String                  @map("root_reference")
  defaultBranch        String?                 @map("default_branch") @db.VarChar(255)
  status               ProjectStatus           @default(AVAILABLE)
  deploymentProtection Json?                   @map("deployment_protection")
  webhookSecret        String?                 @map("webhook_secret") @db.VarChar(255)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkpoints          Checkpoint[]
  deployments          Deployment[]
  sessions             Session[]
  bridge               Bridge?                 @relation(fields: [bridgeId], references: [id])
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks                Task[]
  taskSchedules        TaskSchedule[]
  memories             ProjectMemory[]
  secrets              DeploymentSecret[]
  envVars              DeploymentEnvVar[]
  teamPermissions      ProjectTeamPermission[]
  fileVersions         FileVersion[]

  @@index([workspaceId])
  @@index([status])
  @@map("projects")
}

model WorkspaceInstructionVersion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  version     Int
  content     String
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  author      User      @relation("InstructionAuthor", fields: [createdBy], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@map("workspace_instruction_versions")
}

model WorkspacePolicy {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @unique @map("workspace_id") @db.Uuid
  requirePlanApproval    Boolean          @default(true) @map("require_plan_approval")
  allowDirectExecution   Boolean          @default(false) @map("allow_direct_execution")
  maxTaskDurationSeconds Int              @default(1800) @map("max_task_duration_seconds")
  maxToolCallsPerRun     Int              @default(50) @map("max_tool_calls_per_run")
  maxSubagents           Int              @default(0) @map("max_subagents")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  blockOnReviewFindings  Boolean          @default(false) @map("block_on_review_findings")
  toolRules              ToolPolicyRule[]
  workspace              Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_policies")
}

model ToolPolicyRule {
  id                String             @id @default(uuid()) @db.Uuid
  workspacePolicyId String             @map("workspace_policy_id") @db.Uuid
  toolName          String             @map("tool_name") @db.VarChar(120)
  actionPattern     String?            @map("action_pattern")
  riskLevel         RiskLevel          @map("risk_level")
  decision          PermissionDecision @map("decision")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  policy            WorkspacePolicy    @relation(fields: [workspacePolicyId], references: [id], onDelete: Cascade)

  @@index([workspacePolicyId, toolName])
  @@map("tool_policy_rules")
}

model ProviderConnection {
  id                  String                        @id @default(uuid()) @db.Uuid
  userId              String                        @map("user_id") @db.Uuid
  providerType        ProviderType                  @map("provider_type")
  displayName         String                        @map("display_name") @db.VarChar(120)
  encryptedCredential Bytes?                        @map("encrypted_credential")
  encryptedMetadata   Bytes?                        @map("encrypted_metadata")
  status              ProviderConnectionStatus      @default(ACTIVE)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  modelRoutes         ModelRoute[]
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrideTasks       Task[]                        @relation("TaskModelOverride")
  workspaceLinks      WorkspaceProviderConnection[]
  healthChecks        ProviderHealthCheck[]

  @@index([userId])
  @@index([status])
  @@map("provider_connections")
}

model WorkspaceProviderConnection {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  providerConnectionId String             @map("provider_connection_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerConnectionId])
  @@map("workspace_provider_connections")
}

model ModelRoute {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @map("workspace_id") @db.Uuid
  stage                ModelStage
  providerConnectionId String             @map("provider_connection_id") @db.Uuid
  modelIdentifier      String             @map("model_identifier") @db.VarChar(255)
  fallbackRouteId      String?            @map("fallback_route_id") @db.Uuid
  priority             Int                @default(100)
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  fallbackRoute        ModelRoute?        @relation("RouteFallback", fields: [fallbackRouteId], references: [id])
  fallbackFor          ModelRoute[]       @relation("RouteFallback")
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id])
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, stage, active])
  @@map("model_routes")
}

model Task {
  id                           String               @id @default(uuid()) @db.Uuid
  workspaceId                  String               @map("workspace_id") @db.Uuid
  projectId                    String               @map("project_id") @db.Uuid
  createdBy                    String               @map("created_by") @db.Uuid
  goal                         String
  constraints                  String?
  state                        TaskState            @default(QUEUED)
  selectedModelMode            ModelSelectionMode   @default(ROUTED) @map("selected_model_mode")
  overrideProviderConnectionId String?              @map("override_provider_connection_id") @db.Uuid
  overrideModelIdentifier      String?              @map("override_model_identifier") @db.VarChar(255)
  cancelRequested              Boolean              @default(false) @map("cancel_requested")
  pauseRequested               Boolean              @default(false) @map("pause_requested")
  createdAt                    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt                  DateTime?            @map("completed_at") @db.Timestamptz(6)
  agentMode                    AgentMode            @default(BUILD) @map("agent_mode")
  archivedAt                   DateTime?            @map("archived_at") @db.Timestamptz(6)
  isPinned                     Boolean              @default(false) @map("is_pinned")
  parentTaskId                 String?              @map("parent_task_id") @db.Uuid
  taskBranches                 TaskBranch[]
  approvals                    ApprovalRequest[]
  checkpoints                  Checkpoint[]
  contextPackages              ContextPackage[]
  exports                      SessionExport[]
  shares                       SessionShare[]
  events                       TaskEvent[]
  plans                        TaskPlan[]
  runs                         TaskRun[]
  scheduleLinks                TaskSchedule[]            @relation("TaskScheduleLastTask")
  creator                      User                 @relation("TaskCreator", fields: [createdBy], references: [id])
  overrideProvider             ProviderConnection?  @relation("TaskModelOverride", fields: [overrideProviderConnectionId], references: [id])
  parentTask                   Task?                @relation("TaskFork", fields: [parentTaskId], references: [id])
  childTasks                   Task[]               @relation("TaskFork")
  project                      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace                    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolCalls                    ToolCall[]
  verifications                VerificationResult[]
  deployments                  Deployment[]
  executionTraces              ExecutionTrace[]

  @@index([workspaceId, state])
  @@index([projectId])
  @@index([createdBy])
  @@index([state])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskRun {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  runNumber      Int       @map("run_number")
  state          TaskState @default(QUEUED)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  failureCode    String?   @map("failure_code") @db.VarChar(100)
  failureMessage String?   @map("failure_message")
  inputTokens    Int?      @default(0) @map("input_tokens")
  outputTokens   Int?      @default(0) @map("output_tokens")
  totalTokens    Int?      @default(0) @map("total_tokens")
  estimatedCost  Float?    @default(0) @map("estimated_cost")
  modelUsed      String?   @map("model_used") @db.VarChar(255)
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, runNumber])
  @@map("task_runs")
}

model TaskPlan {
  id               String     @id @default(uuid()) @db.Uuid
  taskId           String     @map("task_id") @db.Uuid
  runId            String     @map("run_id") @db.Uuid
  version          Int
  analysis         String
  affectedFiles    Json       @map("affected_files")
  steps            Json
  risks            Json
  verificationPlan Json       @map("verification_plan")
  status           PlanStatus @default(DRAFT)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt       DateTime?  @map("approved_at") @db.Timestamptz(6)
  approvedBy       String?    @map("approved_by") @db.Uuid
  approver         User?      @relation("PlanApprover", fields: [approvedBy], references: [id])
  task             Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([taskId, status])
  @@map("task_plans")
}

model ContextPackage {
  id              String       @id @default(uuid()) @db.Uuid
  taskId          String       @map("task_id") @db.Uuid
  runId           String       @map("run_id") @db.Uuid
  stage           ContextStage
  manifest        Json
  estimatedTokens Int          @default(0) @map("estimated_tokens")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, runId])
  @@map("context_packages")
}

model TaskEvent {
  id             String         @id @default(uuid()) @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  runId          String?        @map("run_id") @db.Uuid
  sequenceNumber BigInt         @map("sequence_number")
  eventType      String         @map("event_type") @db.VarChar(100)
  actorType      EventActorType @default(SYSTEM) @map("actor_type")
  payload        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequenceNumber])
  @@index([eventType])
  @@map("task_events")
}

model ToolCall {
  id            String            @id @default(uuid()) @db.Uuid
  taskId        String            @map("task_id") @db.Uuid
  runId         String            @map("run_id") @db.Uuid
  toolName      String            @map("tool_name") @db.VarChar(120)
  riskLevel     RiskLevel         @map("risk_level")
  inputSummary  Json              @map("input_summary")
  status        ToolCallStatus    @default(PENDING)
  resultSummary Json?             @map("result_summary")
  startedAt     DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(6)
  approvals     ApprovalRequest[]
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, runId])
  @@index([runId])
  @@index([status])
  @@map("tool_calls")
}

model ApprovalRequest {
  id               String            @id @default(uuid()) @db.Uuid
  taskId           String            @map("task_id") @db.Uuid
  toolCallId       String?           @map("tool_call_id") @db.Uuid
  requestedScope   ApprovalScope     @map("requested_scope")
  status           ApprovalStatus    @default(PENDING)
  requestedByActor ApprovalRequester @default(AGENT) @map("requested_by_actor")
  decidedBy        String?           @map("decided_by") @db.Uuid
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz(6)
  decider          User?             @relation("ApprovalDecider", fields: [decidedBy], references: [id])
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolCall         ToolCall?         @relation(fields: [toolCallId], references: [id])

  @@index([taskId, status])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

model Bridge {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String              @db.VarChar(120)
  version         String              @db.VarChar(50)
  status          BridgeStatus        @default(PENDING)
  capabilities    Json?
  lastSeenAt      DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  deviceTokenHash String?             @unique @map("device_token_hash")
  projectRoots    BridgeProjectRoot[]
  user            User                @relation(fields: [userId], references: [id])
  projects        Project[]

  @@index([userId])
  @@index([status])
  @@map("bridges")
}

model BridgeProjectRoot {
  id                     String   @id @default(uuid()) @db.Uuid
  bridgeId               String   @map("bridge_id") @db.Uuid
  displayName            String   @map("display_name") @db.VarChar(160)
  canonicalRootReference String   @map("canonical_root_reference")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bridge                 Bridge   @relation(fields: [bridgeId], references: [id], onDelete: Cascade)

  @@unique([bridgeId, canonicalRootReference])
  @@map("bridge_project_roots")
}

model McpServer {
  id              String               @id @default(uuid()) @db.Uuid
  ownerId         String               @map("owner_id") @db.Uuid
  name            String               @db.VarChar(120)
  transportType   McpTransportType     @map("transport_type")
  encryptedConfig Bytes                @map("encrypted_config")
  status          McpServerStatus      @default(DISABLED)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  discoveredTools Json?                @map("discovered_tools")
  owner           User                 @relation(fields: [ownerId], references: [id])
  workspaces      WorkspaceMcpServer[]

  @@index([ownerId])
  @@map("mcp_servers")
}

model WorkspaceMcpServer {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  mcpServerId String    @map("mcp_server_id") @db.Uuid
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  server      McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, mcpServerId])
  @@map("workspace_mcp_servers")
}

model Checkpoint {
  id             String         @id @default(uuid()) @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  checkpointType CheckpointType @default(PRE_EXECUTION) @map("checkpoint_type")
  stateReference Json           @map("state_reference")
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  creator        User?          @relation("CheckpointCreator", fields: [createdBy], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deployments    Deployment[]

  @@index([taskId])
  @@map("checkpoints")
}

model VerificationResult {
  id              String             @id @default(uuid()) @db.Uuid
  taskId          String             @map("task_id") @db.Uuid
  runId           String             @map("run_id") @db.Uuid
  command         String
  status          VerificationStatus @default(SKIPPED)
  outputReference String?            @map("output_reference")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  task            Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, runId])
  @@map("verification_results")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  action      String     @db.VarChar(120)
  entityType  String     @map("entity_type") @db.VarChar(80)
  entityId    String?    @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?      @relation(fields: [actorUserId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model WorkspaceInvite {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String        @db.VarChar(320)
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique @map("token_hash")
  invitedBy   String        @map("invited_by") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  inviter     User          @relation(fields: [invitedBy], references: [id])
