# Public URL of the AI Harness API. On Vercel set this as a project env var
# BEFORE the first build — it is baked into the bundle (the /env.js runtime
# override is Docker-only).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
