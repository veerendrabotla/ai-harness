{
  "name": "ai-harness",
  "displayName": "AI Harness",
  "description": "AI-powered software engineering assistant for AI Harness platform",
  "version": "0.1.0",
  "publisher": "ai-harness",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:ai-harness.connect",
    "onCommand:ai-harness.newTask",
    "onCommand:ai-harness.approve",
    "onCommand:ai-harness.deny",
    "onCommand:ai-harness.openChat",
    "onCommand:ai-harness.showDiagnostics",
    "onView:ai-harness.tasks"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-harness.connect",
        "title": "AI Harness: Connect to Server"
      },
      {
        "command": "ai-harness.newTask",
        "title": "AI Harness: New Task"
      },
      {
        "command": "ai-harness.approve",
        "title": "AI Harness: Approve Action"
      },
      {
        "command": "ai-harness.deny",
        "title": "AI Harness: Deny Action"
      },
      {
        "command": "ai-harness.openChat",
        "title": "AI Harness: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ai-harness.showDiagnostics",
        "title": "AI Harness: Show Diagnostics",
        "icon": "$(warning)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-harness",
          "title": "AI Harness",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "ai-harness": [
        {
          "type": "tree",
          "id": "ai-harness.tasks",
          "name": "Tasks"
        },
        {
          "type": "webview",
          "id": "ai-harness.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "AI Harness",
      "properties": {
        "ai-harness.serverUrl": {
          "type": "string",
          "default": "http://localhost:4010",
          "description": "AI Harness Gateway URL"
        },
        "ai-harness.apiToken": {
          "type": "string",
          "default": "",
          "description": "API authentication token"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
