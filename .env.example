# ──────────────────────────────────────────────────────────────
# AI Harness â€” environment configuration template
# Copy to .env and fill values. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of this API (used in tokens/docs)
API_BASE_URL=http://localhost:4000

# ── Database (PostgreSQL 17) ───────────────────────────────────
DATABASE_URL=postgresql://ai_harness:ai_harness@localhost:5432/ai_harness?schema=public
# Used by Prisma Migrate for shadow database (migrations only)
SHADOW_DATABASE_URL=postgresql://ai_harness:ai_harness@localhost:5432/ai_harness_shadow?schema=public

# ── Redis 7.4 (queue + rate limiting) ──────────────────────────
REDIS_URL=redis://:ai_harness_redis@localhost:6379

# ── Worker ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ── Authentication ─────────────────────────────────────────────
# 32+ byte random secret for signing JWT access tokens (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
# HMAC key for CSRF double-submit cookies — REQUIRED in production (NODE_ENV=production)
CSRF_SECRET=change-me-generate-a-long-random-secret
JWT_ISSUER=ai-harness
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ── Encryption / secrets ───────────────────────────────────────
# 32-byte base64 key for AES-256-GCM encryption of provider credentials
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-encoded-32-bytes==

# ── AI providers ───────────────────────────────────────────────
# Provider API keys are USER-managed: they are submitted through the UI/API,
# encrypted at rest (AES-256-GCM) and stored per-user in provider_connections.
# No platform-level model keys are required. Reserved for future server-side defaults:
# PLATFORM_ANTHROPIC_API_KEY=
# PLATFORM_OPENAI_API_KEY=

# ── Storage (reserved â€” Google Cloud Storage, later phase) ────
GCS_BUCKET=
GCS_PROJECT_ID=

# ── Local Bridge ────────────────────────────────────────────────
BRIDGE_PAIRING_TOKEN_TTL_MINUTES=15
BRIDGE_SESSION_TOKEN_TTL_MINUTES=10
BRIDGE_GATEWAY_PORT=4010
BRIDGE_GATEWAY_URL=http://localhost:4010
# 48-byte random secret shared between api/worker and the bridge gateway
BRIDGE_INTERNAL_TOKEN=change-me-generate-a-long-random-secret

# Rate limit overrides - raised for local parallel integration tests (prod defaults 5/10/5, global 100/min)
RATE_LIMIT_SIGNUP_PER_HOUR=100
RATE_LIMIT_LOGIN_PER_15MIN=500
RATE_LIMIT_RESET_PER_HOUR=5
# Global per-IP/per-user API budget (default 100/min; raised for local parallel tests)
RATE_LIMIT_GLOBAL_MAX=1000

# ── Observability ──────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend (apps/frontend/.env.local) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# -- Cloud Sandbox (optional local Docker sandbox) --------------
# SANDBOX_MODE=docker enables ephemeral container execution for CLOUD_SANDBOX tools
SANDBOX_MODE=
SANDBOX_IMAGE=node:22-alpine

# ── Webhook Secrets (optional â€” when unset, signature verification is skipped)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=

# ── SSO (optional) ────────────────────────────────────────
OKTA_ISSUER_URL=

# ── Stripe Billing ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
